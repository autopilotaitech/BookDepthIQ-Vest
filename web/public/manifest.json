{
  "manifest_version": 3,
  "name": "BookDepthIQ-Vest",
  "version": "1.8.5",
  "description": "Scalping panel for Vest Markets perps. PAPER by default; LIVE sends real orders to the Vest account you are logged into.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open BookDepthIQ-Vest panel",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://api-gateway.hz.vestmarkets.com/*",
    "wss://ws.hz.vestmarkets.com/*",
    "https://next.vestmarkets.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://next.vestmarkets.com/*"],
      "js": ["vest-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://next.vestmarkets.com/*"],
      "js": ["vest-relay.js"],
      "run_at": "document_start"
    }
  ]
}
